# --- Database (PostgreSQL: Supabase / Neon / local) ---
DATABASE_URL="postgresql://mithmill:mithmill@localhost:5432/mithmill"
DIRECT_URL="postgresql://mithmill:mithmill@localhost:5432/mithmill"

# --- Redis (BullMQ) ---
REDIS_URL="redis://localhost:6379"

# --- Auth.js ---
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/common/v2.0"

# Magic-link sender (SMTP used for login emails only)
EMAIL_SERVER=""  # e.g. smtp://user:pass@smtp.example.com:587 — enables magic-link login
EMAIL_FROM="MithMill <login@mithmill.app>"

# --- Secrets encryption (32 bytes, base64). openssl rand -base64 32 ---
ENCRYPTION_KEY=""

# --- Tracking ---
# Default host used for open/click tracking when a workspace has no verified custom tracking domain.
APP_URL="http://localhost:3000"
# Custom tracking domains must CNAME to this host.
TRACKING_CNAME_TARGET="track.mithmill.app"

# --- AI ---
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
